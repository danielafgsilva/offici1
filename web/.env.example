# Optional
CONTACT_TO_EMAIL=
# Optional: where job applications (with the CV attached) are sent. Defaults to the contact address.
CAREERS_TO_EMAIL=

# Public address of the site, without a trailing slash. Used for canonical URLs, the sitemap and structured data.
NEXT_PUBLIC_SITE_URL=
